# Archivo de entorno ejemplo para SupplierHistoryAI
# Copiar este archivo a .env y ajustar los valores según sea necesario

# Configuración general
APP_NAME="SupplierHistoryAI"
APP_VERSION="1.0.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8501

# Configuración de Streamlit
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=true

# Configuración de Ollama (IA Local)
OLLAMA_SERVER_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:8b"
OLLAMA_TIMEOUT=60

# Configuración de ChromaDB (Base de Datos Vectorial)
CHROMADB_PATH="./chroma_db"
CHROMADB_COLLECTION_NAME="documentos_contratos"

# Configuración de documentos
DOCUMENTOS_PATH="./data/raw_docs"
ARCHIVO_DATABASE="data/database.json"

# Configuración de embeddings
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32

# Configuración de límites
MAX_TOKENS_RESPUESTA=1000
MAX_DOCUMENTOS_CARGAR=20
LIMITE_TIEMPO_BÚSQUEDA=30

# Configuración de seguridad
DISABLE_REMOTE_MODELS=true
MODO_SOLAMENTE_LOCAL=true

# Configuración de logging
NIVEL_LOGGING="INFO"
ARCHIVO_LOGGING="logs/supplier_history_ai.log"

# Configuración de rendimiento
USAR_CUDA=true
NUMERO_THREADS=4
TAMANO_CHUNK_DOCUMENTO=500

# Variables opcionales para modelos alternativos
# OLLAMA_MODELO_ALTERNATIVO="qwen2.5:7b"
# EMBEDDING_MODELO_ALTERNATIVO="paraphrase-multilingual"

# Configuración de despliegue
UBICACION_DESPLIEGUE="local"
REQUIERE_REINICIO=false
